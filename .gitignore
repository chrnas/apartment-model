# Large 3D source models are never committed.
# Only the optimized client/public/apartment.glb (tracked via client/.gitignore) ships.
*.glb
!client/public/apartment.glb

# Local scratch folder: drop raw/uncompressed .glb files here to compress them.
# Everything inside is ignored except the README that documents it.
/models-raw/*
!/models-raw/README.md

# Local Vercel link info
.vercel/

# Node
node_modules/
